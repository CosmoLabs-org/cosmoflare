{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window. Grants core defaults plus shell plugin scoped to the cosmoflare sidecar only.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-kill",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "cosmoflare",
          "sidecar": true,
          "args": ["serve", "--addr", { "validator": "^127\\.0\\.0\\.1:\\d+$" }]
        }
      ]
    }
  ]
}
