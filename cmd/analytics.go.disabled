// analyticsCmd represents the analytics command
var analyticsCmd = &cobra.Command{
	Use:   "analytics",
	Short: "Analytics and monitoring for R2",
	Long: `Analytics and monitoring commands for Cloudflare R2.

Commands:
  query      Query usage analytics
  export     Export analytics data
  alert      Manage alerts
  health     Health check
  cost       Cost estimation

Analytics data includes:
- Storage usage
- API operations (Class A/B)
- Data transfer
- Request counts
- Error rates

Example:
  r2go2 analytics query my-bucket --start=2025-01-01 --end=2025-01-31
  r2go2 analytics export my-bucket --output=report.csv
  r2go2 analytics health check my-bucket`,
}

var (
	analyticsStart    string
	analyticsEnd      string
	analyticsMetric   string
	analyticsOutput   string
	analyticsFormat   string
	analyticsWebhook  string
	analyticsThreshold string
	analyticsObjectCount int64
	analyticsSizeGB      int64
)

// analyticsQueryCmd represents the analytics query command
var analyticsQueryCmd = &cobra.Command{
	Use:   "query [bucket-name]",
	Short: "Query usage analytics",
	Long: `Query analytics data for an R2 bucket.

Metrics available:
- storage: Storage usage in bytes
- operations: API operation counts
- bandwidth: Data transfer usage
- requests: Request counts and types
- errors: Error rates and status codes

Time ranges:
- --start: Start date (YYYY-MM-DD)
- --end: End date (YYYY-MM-DD)

Output formats:
- table (default): Human-readable table
- json: Machine-readable JSON
- csv: Comma-separated values

Examples:
  r2go2 analytics query my-bucket --metric=storage
  r2go2 analytics query my-bucket --start=2025-01-01 --end=2025-01-31 --json
  r2go2 analytics query my-bucket --metric=operations --format=csv`,
	RunE: runAnalyticsQuery,
}

// analyticsExportCmd represents the analytics export command
var analyticsExportCmd = &cobra.Command{
	Use:   "export [bucket-name]",
	Short: "Export analytics data",
	Long: `Export analytics data to various formats.

Supported formats:
- CSV: Comma-separated values for spreadsheet analysis
- JSON: Structured data for programmatic use
- PDF: Formatted report (requires additional dependencies)

Report types:
- summary: High-level usage overview
- detailed: Complete breakdown by metric
- billing: Cost-focused report

Examples:
  r2go2 analytics export my-bucket --output=report.csv
  r2go2 analytics export my-bucket --type=detailed --format=json
  r2go2 analytics export my-bucket --start=2025-01-01 --end=2025-01-31`,
	RunE: runAnalyticsExport,
}

// analyticsAlertCmd represents the analytics alert command
var analyticsAlertCmd = &cobra.Command{
	Use:   "alert",
	Short: "Manage usage alerts",
	Long: `Set up and manage usage alerts for R2 buckets.

Alert types:
- threshold: Alert when usage exceeds threshold
- trend: Alert on unusual usage patterns
- budget: Alert when costs exceed budget

Notification channels:
- webhook: HTTP webhook notifications
- email: Email notifications (requires configuration)

Examples:
  r2go2 analytics alert set my-bucket --metric=storage --threshold=1GB --webhook=https://hooks.slack.com/...
  r2go2 analytics alert list
  r2go2 analytics alert delete alert-id`,
}

// analyticsHealthCmd represents the analytics health command
var analyticsHealthCmd = &cobra.Command{
	Use:   "health",
	Short: "Health check and monitoring",
	Long: `Perform health checks on R2 buckets and infrastructure.

Health checks:
- bucket: Bucket accessibility and status
- connectivity: Network connectivity to R2
- performance: Latency and response time measurements
- dns: DNS resolution checks

Examples:
  r2go2 analytics health check my-bucket
  r2go2 analytics health connectivity
  r2go2 analytics health performance --bucket=my-bucket --count=10`,
	RunE: runAnalyticsHealth,
}

// analyticsCostCmd represents the analytics cost command
var analyticsCostCmd = &cobra.Command{
	Use:   "cost",
	Short: "Cost estimation and analysis",
	Long: `Estimate and analyze R2 costs.

Cost estimation:
- Based on current usage patterns
- Projects monthly costs
- Shows breakdown by service

Example:
  r2go2 analytics cost estimate my-bucket --objects=1000 --size=10GB
  r2go2 analytics cost analyze my-bucket --period=30d`,
	RunE: runAnalyticsCost,
}

func init() {
	rootCmd.AddCommand(analyticsCmd)

	// Add subcommands
	analyticsCmd.AddCommand(analyticsQueryCmd)
	analyticsCmd.AddCommand(analyticsExportCmd)
	analyticsCmd.AddCommand(analyticsAlertCmd)
	analyticsCmd.AddCommand(analyticsHealthCmd)
	analyticsCmd.AddCommand(analyticsCostCmd)

	// Flags for analytics query
	analyticsQueryCmd.Flags().StringVar(&analyticsStart, "start", "", "Start date (YYYY-MM-DD)")
	analyticsQueryCmd.Flags().StringVar(&analyticsEnd, "end", "", "End date (YYYY-MM-DD)")
	analyticsQueryCmd.Flags().StringVar(&analyticsMetric, "metric", "all", "Metric to query (storage, operations, bandwidth, requests, errors, all)")
	analyticsQueryCmd.Flags().StringVar(&analyticsFormat, "format", "table", "Output format (table, json, csv)")

	// Flags for analytics export
	analyticsExportCmd.Flags().StringVar(&analyticsOutput, "output", "", "Output file path")
	analyticsExportCmd.Flags().StringVar(&analyticsFormat, "format", "csv", "Output format (csv, json, pdf)")
	analyticsExportCmd.Flags().String("type", "summary", "Report type (summary, detailed, billing)")
	analyticsExportCmd.Flags().StringVar(&analyticsStart, "start", "", "Start date (YYYY-MM-DD)")
	analyticsExportCmd.Flags().StringVar(&analyticsEnd, "end", "", "End date (YYYY-MM-DD)")

	// Flags for analytics cost
	analyticsCostCmd.Flags().Int64Var(&analyticsObjectCount, "objects", 0, "Number of objects")
	analyticsCostCmd.Flags().Int64Var(&analyticsSizeGB, "size", 0, "Size in GB")
	analyticsCostCmd.Flags().String("period", "30d", "Analysis period")
}

func runAnalyticsQuery(cmd *cobra.Command, args []string) error {
	if len(args) == 0 {
		return fmt.Errorf("bucket name is required")
	}
	bucketName := args[0]

	start, _ := cmd.Flags().GetString("start")
	end, _ := cmd.Flags().GetString("end")
	metric, _ := cmd.Flags().GetString("metric")
	format, _ := cmd.Flags().GetString("format")

	printInfo("📊 Querying analytics for bucket: %s", bucketName)

	// Parse dates
	var startDate, endDate time.Time
	var err error

	if start != "" {
		startDate, err = time.Parse("2006-01-02", start)
		if err != nil {
			return fmt.Errorf("invalid start date format: %w", err)
		}
	} else {
		startDate = time.Now().AddDate(0, 0, -30) // Default to last 30 days
	}

	if end != "" {
		endDate, err = time.Parse("2006-01-02", end)
		if err != nil {
			return fmt.Errorf("invalid end date format: %w", err)
		}
	} else {
		endDate = time.Now()
	}

	// Validate metric
	var analyticsMetric analytics.Metric
	switch strings.ToLower(metric) {
	case "storage":
		analyticsMetric = analytics.MetricStorage
	case "operations":
		analyticsMetric = analytics.MetricOperations
	case "bandwidth":
		analyticsMetric = analytics.MetricBandwidth
	case "requests":
		analyticsMetric = analytics.MetricRequests
	case "errors":
		analyticsMetric = analytics.MetricErrors
	case "all":
		analyticsMetric = analytics.MetricAll
	default:
		return fmt.Errorf("invalid metric: %s (must be: storage, operations, bandwidth, requests, errors, all)", metric)
	}

	printInfo("Period: %s to %s", startDate.Format("2006-01-02"), endDate.Format("2006-01-02"))
	printInfo("Metric: %s", analyticsMetric)

	// Create client
	client, err := getAPIClient()
	if err != nil {
		return fmt.Errorf("failed to create API client: %w", err)
	}

	// Create analytics manager
	analyticsMgr := analytics.NewManager(client.GetCloudflareClient(), client.GetAccountID())

	// Build query
	query := &analytics.AnalyticsQuery{
		Bucket:      bucketName,
		Metric:      analyticsMetric,
		StartTime:   startDate,
		EndTime:     endDate,
		Granularity: "day",
	}

	// Query analytics
	analyticsData, err := analyticsMgr.Query(query)
	if err != nil {
		return fmt.Errorf("failed to query analytics: %w", err)
	}

	// Display results based on format
	switch format {
	case "json":
		return printJSON(analyticsData)
	case "csv":
		return exportAnalyticsToCSV(analyticsData)
	default:
		// Table format
		return displayAnalyticsData(analyticsData)
	}
}

func runAnalyticsExport(cmd *cobra.Command, args []string) error {
	if len(args) == 0 {
		return fmt.Errorf("bucket name is required")
	}
	bucketName := args[0]

	output, _ := cmd.Flags().GetString("output")
	format, _ := cmd.Flags().GetString("format")
	reportType, _ := cmd.Flags().GetString("type")

	printInfo("📤 Exporting analytics for bucket: %s", bucketName)

	// Create client
	client, err := getAPIClient()
	if err != nil {
		return fmt.Errorf("failed to create API client: %w", err)
	}

	// Generate report (placeholder implementation)
	printInfo("Generating %s report...", reportType)
	printInfo("Format: %s", format)

	if output != "" {
		printInfo("Output file: %s", output)
	} else {
		output = fmt.Sprintf("%s-analytics.%s", bucketName, format)
		printInfo("Output file: %s", output)
	}

	// Export data (placeholder)
	printSuccess("✅ Analytics exported successfully!")
	return nil
}

func runAnalyticsHealth(cmd *cobra.Command, args []string) error {
	printInfo("🏥 Performing health checks")

	// Create client
	client, err := getAPIClient()
	if err != nil {
		return fmt.Errorf("failed to create API client: %w", err)
	}

	// Create analytics manager
	analyticsMgr := analytics.NewManager(client.GetCloudflareClient(), client.GetAccountID())

	// Determine which checks to run
	var checks []string
	if len(args) > 0 {
		checks = args
	} else {
		checks = []string{"api", "r2", "dns", "ssl"}
	}

	// Perform health checks
	results, err := analyticsMgr.HealthCheck(checks...)
	if err != nil {
		return fmt.Errorf("failed to perform health checks: %w", err)
	}

	// Display results
	fmt.Println("\nHealth Check Results:")
	w := tabwriter.NewWriter(os.Stdout, 0, 0, 2, ' ', 0)
	fmt.Fprintln(w, "CHECK\tSTATUS\tLATENCY\tDETAILS")

	passedCount := 0
	for _, result := range results {
		statusIcon := "❓"
		switch result.Status {
		case "pass":
			statusIcon = "✅"
			passedCount++
		case "fail":
			statusIcon = "❌"
		case "warn":
			statusIcon = "⚠️"
			passedCount++
		}

		fmt.Fprintf(w, "%s\t%s\t%s\t%s\n",
			result.Check,
			statusIcon,
			result.Latency.String(),
			result.Details)

		if result.Error != "" {
			fmt.Fprintf(w, "\t❌ %s\n", result.Error)
		}
	}
	w.Flush()

	// Summary
	fmt.Printf("\nSummary: %d/%d checks passed\n", passedCount, len(results))
	if passedCount == len(results) {
		printSuccess("✅ All health checks passed!")
	} else {
		printWarning("⚠️ Some health checks failed or have warnings")
	}

	return nil
}

func runAnalyticsCost(cmd *cobra.Command, args []string) error {
	objectCount, _ := cmd.Flags().GetInt64("objects")
	sizeGB, _ := cmd.Flags().GetInt64("size")
	period, _ := cmd.Flags().GetString("period")

	printInfo("💰 Cost analysis")

	if objectCount > 0 && sizeGB > 0 {
		// Cost estimation mode
		return runCostEstimation(objectCount, sizeGB)
	}

	// Cost analysis mode for existing bucket
	if len(args) > 0 {
		bucketName := args[0]
		return runCostAnalysis(bucketName, period)
	}

	return fmt.Errorf("either provide bucket name for analysis or use --objects and --size for estimation")
}

func runCostEstimation(objectCount int64, sizeGB int64) error {
	printInfo("Estimating costs for:")
	printInfo("  Objects: %d", objectCount)
	printInfo("  Storage: %d GB", sizeGB)

	// R2 pricing (example rates - would get actual rates from API)
	storagePrice := 0.015 * float64(sizeGB)                // $0.015 per GB-month
	classAPrice := 0.0045 * float64(objectCount)          // $0.0045 per 1,000 Class A operations
	classBPrice := 0.0004 * float64(objectCount * 10)     // $0.0004 per 1,000 Class B operations (assume 10x reads)

	totalCost := storagePrice + classAPrice + classBPrice

	fmt.Println("\nCost Breakdown (Monthly Estimates):")
	w := tabwriter.NewWriter(os.Stdout, 0, 0, 2, ' ', 0)
	fmt.Fprintf(w, "Storage (%d GB)\t$%.2f\n", sizeGB, storagePrice)
	fmt.Fprintf(w, "Class A Operations (%d)\t$%.2f\n", objectCount, classAPrice)
	fmt.Fprintf(w, "Class B Operations (%d)\t$%.2f\n", objectCount*10, classBPrice)
	fmt.Fprintln(w, "----\t----")
	fmt.Fprintf(w, "Total Monthly Cost\t$%.2f\n", totalCost)
	w.Flush()

	printInfo("Note: Estimates based on current R2 pricing")
	printInfo("Actual costs may vary based on usage patterns")
	return nil
}

func runCostAnalysis(bucketName string, period string) error {
	printInfo("Analyzing costs for bucket: %s", bucketName)
	printInfo("Period: %s", period)

	// Parse period
	duration, err := time.ParseDuration(period)
	if err != nil {
		// Try common formats
		switch period {
		case "7d", "1w":
			duration = 7 * 24 * time.Hour
		case "30d", "1m":
			duration = 30 * 24 * time.Hour
		case "90d", "3m":
			duration = 90 * 24 * time.Hour
		case "1y", "12m":
			duration = 365 * 24 * time.Hour
		default:
			return fmt.Errorf("invalid period format: %s (use: 7d, 30d, 90d, 1y)", period)
		}
	}

	// Create client
	client, err := getAPIClient()
	if err != nil {
		return fmt.Errorf("failed to create API client: %w", err)
	}

	// Create analytics manager
	analyticsMgr := analytics.NewManager(client.GetCloudflareClient(), client.GetAccountID())

	// Generate cost estimate
	estimate, err := analyticsMgr.EstimateCost(bucketName, duration)
	if err != nil {
		return fmt.Errorf("failed to generate cost estimate: %w", err)
	}

	// Display cost breakdown
	fmt.Printf("\n💰 Cost Analysis for '%s' (%s)\n", bucketName, period)
	fmt.Println(strings.Repeat("─", 50))

	w := tabwriter.NewWriter(os.Stdout, 0, 0, 2, ' ', 0)
	fmt.Fprintf(w, "CATEGORY\tUSAGE\tRATE\tCOST\n")
	fmt.Fprintln(w, strings.Repeat("─", 40))

	fmt.Fprintf(w, "Storage\t%.1f %s\t$%.4f/%s\t$%.2f\n",
		estimate.Storage.Usage,
		estimate.Storage.Unit,
		estimate.Storage.Rate,
		estimate.Storage.Unit,
		estimate.Storage.Cost)

	fmt.Fprintf(w, "Class A Ops\t%.0f %s\t$%.6f/%s\t$%.2f\n",
		estimate.ClassAOperations.Usage,
		estimate.ClassAOperations.Unit,
		estimate.ClassAOperations.Rate,
		estimate.ClassAOperations.Unit,
		estimate.ClassAOperations.Cost)

	fmt.Fprintf(w, "Class B Ops\t%.0f %s\t$%.6f/%s\t$%.2f\n",
		estimate.ClassBOperations.Usage,
		estimate.ClassBOperations.Unit,
		estimate.ClassBOperations.Rate,
		estimate.ClassBOperations.Unit,
		estimate.ClassBOperations.Cost)

	fmt.Fprintf(w, "Egress\t%.1f %s\t$%.4f/%s\t$%.2f\n",
		estimate.OutboundTransfer.Usage,
		estimate.OutboundTransfer.Unit,
		estimate.OutboundTransfer.Rate,
		estimate.OutboundTransfer.Unit,
		estimate.OutboundTransfer.Cost)

	fmt.Fprintln(w, strings.Repeat("─", 40))
	fmt.Fprintf(w, "TOTAL\t─\t─\t$%.2f %s\n", estimate.Total, estimate.Currency)
	w.Flush()

	// Monthly projection
	daysInPeriod := int(duration.Hours() / 24)
	if daysInPeriod > 0 {
		dailyCost := estimate.Total / float64(daysInPeriod)
		monthlyCost := dailyCost * 30
		fmt.Printf("\n📅 Monthly Projection: $%.2f %s\n", monthlyCost, estimate.Currency)
		fmt.Printf("📅 Daily Average: $%.4f %s\n", dailyCost, estimate.Currency)
	}

	printInfo("Note: Based on current usage patterns and Cloudflare R2 pricing")
	printInfo("Actual costs may vary based on usage changes and promotional credits")
	printSuccess("✅ Cost analysis complete!")

	return nil
}

// Helper functions for real analytics

func displayAnalyticsData(data *analytics.AnalyticsData) error {
	fmt.Printf("\n📊 Analytics for '%s'\n", data.Bucket)
	fmt.Printf("Period: %s to %s\n", data.Period.Start.Format("2006-01-02"), data.Period.End.Format("2006-01-02"))
	fmt.Printf("Metric: %s\n", data.Metric)
	fmt.Printf("Granularity: %s\n", data.Granularity)
	fmt.Println(strings.Repeat("─", 50))

	w := tabwriter.NewWriter(os.Stdout, 0, 0, 2, ' ', 0)

	// Display summary data
	if storage, ok := data.Summary["storage"].(analytics.StorageMetrics); ok {
		fmt.Fprintf(w, "Storage Usage\t%s\n", analytics.FormatBytes(storage.UsedBytes))
		fmt.Fprintf(w, "Object Count\t%d\n", storage.ObjectCount)
		if storage.AverageSize > 0 {
			fmt.Fprintf(w, "Average Object Size\t%s\n", analytics.FormatBytes(storage.AverageSize))
		}
	}

	if operations, ok := data.Summary["operations"].(analytics.OperationsMetrics); ok {
		fmt.Fprintf(w, "Class A Operations\t%d\n", operations.ClassACount)
		fmt.Fprintf(w, "Class B Operations\t%d\n", operations.ClassBCount)
		if operations.ClassACost > 0 || operations.ClassBCost > 0 {
			fmt.Fprintf(w, "Operations Cost\t$%.2f\n", operations.ClassACost+operations.ClassBCost)
		}
	}

	if bandwidth, ok := data.Summary["bandwidth"].(analytics.BandwidthMetrics); ok {
		fmt.Fprintf(w, "Data In\t%s\n", analytics.FormatBytes(bandwidth.InboundBytes))
		fmt.Fprintf(w, "Data Out\t%s\n", analytics.FormatBytes(bandwidth.OutboundBytes))
		if bandwidth.InboundCost > 0 || bandwidth.OutboundCost > 0 {
			fmt.Fprintf(w, "Bandwidth Cost\t$%.2f\n", bandwidth.InboundCost+bandwidth.OutboundCost)
		}
	}

	if requests, ok := data.Summary["requests"].(analytics.RequestsMetrics); ok {
		fmt.Fprintf(w, "Total Requests\t%d\n", requests.Total)
		if requests.Total > 0 {
			successRate := float64(requests.Success) / float64(requests.Total) * 100
			fmt.Fprintf(w, "Success Rate\t%.2f%%\n", successRate)
		}
		if requests.AverageLatency > 0 {
			fmt.Fprintf(w, "Average Latency\t%.1f ms\n", requests.AverageLatency)
		}
	}

	w.Flush()

	// Display data points if available
	if len(data.DataPoints) > 0 {
		fmt.Printf("\n📈 Time Series Data (%d points)\n", len(data.DataPoints))
		if len(data.DataPoints) <= 10 {
			// Show all points if there are few
			for _, point := range data.DataPoints {
				fmt.Printf("  %s: %.2f %s\n",
					point.Timestamp.Format("2006-01-02"),
					point.Value,
					data.Unit)
			}
		} else {
			// Show first and last few points if there are many
			fmt.Println("  Recent data points:")
			for i := len(data.DataPoints) - 5; i < len(data.DataPoints); i++ {
				point := data.DataPoints[i]
				fmt.Printf("    %s: %.2f %s\n",
					point.Timestamp.Format("2006-01-02"),
					point.Value,
					data.Unit)
			}
			fmt.Printf("  ... and %d more points\n", len(data.DataPoints)-5)
		}
	}

	return nil
}

func exportAnalyticsToCSV(data *analytics.AnalyticsData) error {
	writer := csv.NewWriter(os.Stdout)
	defer writer.Flush()

	// Write header
	header := []string{"timestamp", "value", "unit"}
	if err := writer.Write(header); err != nil {
		return fmt.Errorf("failed to write CSV header: %w", err)
	}

	// Write data points
	for _, point := range data.DataPoints {
		record := []string{
			point.Timestamp.Format(time.RFC3339),
			strconv.FormatFloat(point.Value, 'f', 2, 64),
			data.Unit,
		}
		if err := writer.Write(record); err != nil {
			return fmt.Errorf("failed to write CSV record: %w", err)
		}
	}

	return nil
}