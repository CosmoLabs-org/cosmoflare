package cmd

import (
	"encoding/json"
	"fmt"
	"os"
	"strings"
	"text/tabwriter"
	"time"

	"github.com/spf13/cobra"
	"github.com/CosmoLabs-org/CosmoDev-R2Go2/internal/api"
	"github.com/CosmoLabs-org/CosmoDev-R2Go2/internal/domain"
)

// domainCmd represents the domain command
var domainCmd = &cobra.Command{
	Use:   "domain",
	Short: "Manage custom domains and CDN settings",
	Long: `Custom domain and CDN management for Cloudflare R2.

Commands:
  attach     Attach a custom domain to a bucket
  ls         List custom domains
  detach     Detach a custom domain
  verify     Verify domain configuration
  purge      Purge CDN cache

Custom domains enable:
- Edge caching via Cloudflare CDN
- SSL/TLS certificates
- WAF protection
- Custom analytics

Example:
  r2go2 domain attach my-bucket --domain=assets.example.com
  r2go2 domain ls
  r2go2 domain purge assets.example.com --path=/images/*`,
}

var (
	domainName      string
	domainBucket    string
	domainPath      string
	domainForce     bool
	domainEverything bool
	domainZoneID    string
	domainSSLMode   string
)

// domainAttachCmd represents the domain attach command
var domainAttachCmd = &cobra.Command{
	Use:   "attach [bucket-name]",
	Short: "Attach a custom domain to a bucket",
	Long: `Attach a custom domain to an R2 bucket for CDN access.

Prerequisites:
- Domain must be added as a zone in Cloudflare
- DNS will be automatically configured
- SSL certificate will be automatically provisioned

Options:
- --domain: Custom domain name (required)
- --zone-id: Cloudflare zone ID (auto-detected if not provided)
- --ssl-mode: SSL mode (flexible, full, strict)

Examples:
  r2go2 domain attach my-bucket --domain=assets.example.com
  r2go2 domain attach my-bucket --domain=cdn.example.org --ssl-mode=full`,
	RunE: runDomainAttach,
}

// domainListCmd represents the domain list command
var domainListCmd = &cobra.Command{
	Use:   "list",
	Short: "List custom domains",
	Long: `List all custom domains attached to R2 buckets.

Shows:
- Domain name
- Associated bucket
- SSL status
- DNS status
- Creation date

Filtering options:
- --bucket: Filter by bucket name

Examples:
  r2go2 domain list
  r2go2 domain list --bucket=my-bucket --json`,
	RunE: runDomainList,
}

// domainDetachCmd represents the domain detach command
var domainDetachCmd = &cobra.Command{
	Use:   "detach --domain <domain-name>",
	Short: "Detach a custom domain",
	Long: `Detach a custom domain from an R2 bucket.

⚠️  WARNING: This will remove CDN access and may cause downtime.

Options:
- --domain: Domain name to detach (required)
- --force: Skip confirmation prompt

Examples:
  r2go2 domain detach --domain=assets.example.com
  r2go2 domain detach --domain=assets.example.com --force`,
	RunE: runDomainDetach,
}

// domainVerifyCmd represents the domain verify command
var domainVerifyCmd = &cobra.Command{
	Use:   "verify [domain-name]",
	Short: "Verify domain configuration",
	Long: `Verify the configuration of a custom domain.

Checks:
- DNS configuration
- SSL certificate status
- CDN connectivity
- Origin accessibility

Examples:
  r2go2 domain verify assets.example.com
  r2go2 domain verify assets.example.com --detailed`,
	RunE: runDomainVerify,
}

// domainPurgeCmd represents the domain purge command
var domainPurgeCmd = &cobra.Command{
	Use:   "purge [domain-name]",
	Short: "Purge CDN cache",
	Long: `Purge cached content from Cloudflare CDN.

Purge options:
- --path: Specific path to purge (supports wildcards)
- --everything: Purge entire cache
- --tags: Purge by cache tags

Examples:
  r2go2 domain purge assets.example.com --path=/images/*
  r2go2 domain purge assets.example.com --everything
  r2go2 domain purge assets.example.com --tags=static,versioned`,
	RunE: runDomainPurge,
}

// domainCacheCmd represents the domain cache command
var domainCacheCmd = &cobra.Command{
	Use:   "cache",
	Short: "Manage CDN cache rules",
	Long: `Manage CDN cache rules for custom domains.

Commands:
  create     Create cache rules
  list       List cache rules
  delete     Delete cache rules
  update     Update cache rules

Examples:
  r2go2 domain cache create --domain=assets.example.com --ttl=1month
  r2go2 domain cache list --domain=assets.example.com`,
}

func init() {
	rootCmd.AddCommand(domainCmd)

	// Add subcommands
	domainCmd.AddCommand(domainAttachCmd)
	domainCmd.AddCommand(domainListCmd)
	domainCmd.AddCommand(domainDetachCmd)
	domainCmd.AddCommand(domainVerifyCmd)
	domainCmd.AddCommand(domainPurgeCmd)

	// Cache management subcommand
	domainCmd.AddCommand(domainCacheCmd)

	// Flags for domain attach
	domainAttachCmd.Flags().StringVar(&domainName, "domain", "", "Custom domain name (required)")
	domainAttachCmd.Flags().StringVar(&domainZoneID, "zone-id", "", "Cloudflare zone ID (auto-detected)")
	domainAttachCmd.Flags().StringVar(&domainSSLMode, "ssl-mode", "flexible", "SSL mode (flexible, full, strict)")
	domainAttachCmd.MarkFlagRequired("domain")

	// Flags for domain list
	domainListCmd.Flags().StringVar(&domainBucket, "bucket", "", "Filter by bucket name")

	// Flags for domain detach
	domainDetachCmd.Flags().StringVar(&domainName, "domain", "", "Domain name to detach (required)")
	domainDetachCmd.Flags().BoolVar(&domainForce, "force", false, "Skip confirmation prompt")
	domainDetachCmd.MarkFlagRequired("domain")

	// Flags for domain purge
	domainPurgeCmd.Flags().StringVar(&domainPath, "path", "", "Specific path to purge")
	domainPurgeCmd.Flags().BoolVar(&domainEverything, "everything", false, "Purge entire cache")
}

func runDomainAttach(cmd *cobra.Command, args []string) error {
	if len(args) == 0 {
		return fmt.Errorf("bucket name is required")
	}
	bucketName := args[0]

	domain, _ := cmd.Flags().GetString("domain")
	zoneID, _ := cmd.Flags().GetString("zone-id")
	sslMode, _ := cmd.Flags().GetString("ssl-mode")

	printInfo("🔗 Attaching domain: %s -> %s", domain, bucketName)

	// Create client
	client, err := getAPIClient()
	if err != nil {
		return fmt.Errorf("failed to create API client: %w", err)
	}

	// Validate SSL mode
	var validatedSSLMode domain.SSLMode
	switch strings.ToLower(sslMode) {
	case "off":
		validatedSSLMode = domain.SSLModeOff
	case "flexible":
		validatedSSLMode = domain.SSLModeFlexible
	case "full":
		validatedSSLMode = domain.SSLModeFull
	case "strict":
		validatedSSLMode = domain.SSLModeStrict
	default:
		return fmt.Errorf("invalid SSL mode: %s (must be: off, flexible, full, strict)", sslMode)
	}

	if DryRun {
		printInfo("DRY RUN: Would attach domain '%s' to bucket '%s'", domain, bucketName)
		printInfo("  Zone ID: %s", zoneID)
		printInfo("  SSL Mode: %s", validatedSSLMode)
		return nil
	}

	// Create domain manager
	domainMgr := domain.NewManager(client.GetCloudflareClient(), client.GetAccountID())

	// Attach domain
	req := &domain.AttachRequest{
		Domain:  domain,
		Bucket:  bucketName,
		SSLMode: validatedSSLMode,
		ZoneID:  zoneID,
	}

	resp, err := domainMgr.Attach(req)
	if err != nil {
		return fmt.Errorf("failed to attach domain: %w", err)
	}

	printSuccess("✅ Domain '%s' attached successfully!", domain)
	printInfo("Domain ID: %s", resp.Domain.ID)
	printInfo("Zone: %s (%s)", resp.Domain.ZoneName, resp.Domain.ZoneID)
	printInfo("DNS Record: %s -> %s", resp.DNSRecord.Name, resp.DNSRecord.Content)
	printInfo("DNS Status: %s", resp.Domain.DNSStatus)
	printInfo("SSL Status: %s", resp.Domain.SSLStatus)
	printInfo("Created: %s", resp.Domain.CreatedAt.Format(time.RFC3339))

	if resp.SSLCert != nil {
		printInfo("SSL Certificate ID: %s", resp.SSLCert.ID)
		printInfo("SSL Certificate Status: %s", resp.SSLCert.Status)
	}

	printWarning("⏳ DNS propagation may take a few minutes")
	printInfo("🌐 Ready for: https://%s", domain)

	// Show verification status
	if resp.Domain.Status == "active" {
		printSuccess("✅ Domain is ready for use!")
	} else {
		printWarning("⏳ Domain is provisioning. Run 'r2go2 domain verify %s' to check status", domain)
	}

	return nil
}

func runDomainList(cmd *cobra.Command, args []string) error {
	bucketFilter, _ := cmd.Flags().GetString("bucket")

	printInfo("📋 Listing custom domains")

	// Create client
	client, err := getAPIClient()
	if err != nil {
		return fmt.Errorf("failed to create API client: %w", err)
	}

	// Create domain manager
	domainMgr := domain.NewManager(client.GetCloudflareClient(), client.GetAccountID())

	// List domains
	opts := &domain.ListOptions{
		Bucket: bucketFilter,
	}
	domains, err := domainMgr.List(opts)
	if err != nil {
		return fmt.Errorf("failed to list domains: %w", err)
	}

	if JSONOutput {
		return printJSON(domains)
	}

	// Table format
	if len(domains) == 0 {
		printInfo("No custom domains found")
		return nil
	}

	w := tabwriter.NewWriter(os.Stdout, 0, 0, 2, ' ', 0)
	fmt.Fprintln(w, "DOMAIN\tBUCKET\tSTATUS\tSSL\tDNS\tZONE\tCREATED")
	for _, domain := range domains {
		fmt.Fprintf(w, "%s\t%s\t%s\t%s\t%s\t%s\t%s\n",
			domain.Name,
			domain.Bucket,
			domain.Status,
			domain.SSLStatus,
			domain.DNSStatus,
			domain.ZoneName,
			domain.CreatedAt.Format("2006-01-02"),
		)
	}
	w.Flush()

	printInfo("Total: %d domain(s)", len(domains))
	return nil
}

func runDomainDetach(cmd *cobra.Command, args []string) error {
	domainName, _ := cmd.Flags().GetString("domain")
	force, _ := cmd.Flags().GetBool("force")

	if domainName == "" {
		return fmt.Errorf("domain name is required (--domain flag)")
	}

	printInfo("🔓 Detaching domain: %s", domainName)

	if !force && !DryRun {
		fmt.Printf("Are you sure you want to detach domain '%s'? This may cause downtime. [y/N]: ", domainName)
		var response string
		fmt.Scanln(&response)
		response = strings.TrimSpace(strings.ToLower(response))
		if response != "y" && response != "yes" {
			printInfo("Domain detachment cancelled")
			return nil
		}
	}

	// Create client
	client, err := getAPIClient()
	if err != nil {
		return fmt.Errorf("failed to create API client: %w", err)
	}

	if DryRun {
		printInfo("DRY RUN: Would detach domain '%s'", domainName)
		return nil
	}

	// Create domain manager
	domainMgr := domain.NewManager(client.GetCloudflareClient(), client.GetAccountID())

	// Detach domain
	req := &domain.DetachRequest{
		Domain: domainName,
		Force:  force,
	}

	err = domainMgr.Detach(req)
	if err != nil {
		return fmt.Errorf("failed to detach domain: %w", err)
	}

	printSuccess("✅ Domain '%s' detached successfully!", domainName)
	printWarning("⏳ Note: DNS changes may take time to propagate")
	printInfo("💡 Domain configuration has been completely removed")

	return nil
}

func runDomainVerify(cmd *cobra.Command, args []string) error {
	if len(args) == 0 {
		return fmt.Errorf("domain name is required")
	}
	domainName := args[0]

	printInfo("✅ Verifying domain: %s", domainName)

	// Create client
	client, err := getAPIClient()
	if err != nil {
		return fmt.Errorf("failed to create API client: %w", err)
	}

	// Create domain manager
	domainMgr := domain.NewManager(client.GetCloudflareClient(), client.GetAccountID())

	// Verify domain
	result, err := domainMgr.Verify(domainName)
	if err != nil {
		return fmt.Errorf("failed to verify domain: %w", err)
	}

	// Display results
	fmt.Printf("\nDomain Verification Results for: https://%s\n", domainName)
	w := tabwriter.NewWriter(os.Stdout, 0, 0, 2, ' ', 0)
	fmt.Fprintln(w, "CHECK\tSTATUS\tDETAILS")

	for _, check := range result.Checks {
		statusIcon := "❓"
		switch check.Status {
		case "pass":
			statusIcon = "✅"
		case "fail":
			statusIcon = "❌"
		case "warn":
			statusIcon = "⚠️"
		}

		details := check.Info
		if check.Error != "" {
			details = check.Error
		}

		fmt.Fprintf(w, "%s\t%s\t%s\n", check.Name, statusIcon, details)
	}
	w.Flush()

	// Overall status
	statusIcon := "❓"
	switch result.OverallStatus {
	case "pass":
		statusIcon = "✅"
	case "fail":
		statusIcon = "❌"
	case "warn":
		statusIcon = "⚠️"
	}

	fmt.Printf("\nOverall Status: %s %s (Score: %d/100)\n", statusIcon, strings.ToUpper(result.OverallStatus), result.Score)
	fmt.Printf("Details: %s\n", result.Details)

	// Recommendations
	fmt.Println("\nRecommendations:")
	for _, check := range result.Checks {
		switch check.Name {
		case "DNS Configuration":
			if check.Status != "pass" {
				fmt.Println("• Check that CNAME record points to your R2 bucket")
				fmt.Println("• Wait for DNS propagation (may take 5-10 minutes)")
			}
		case "SSL Certificate":
			if check.Status != "pass" {
				fmt.Println("• SSL certificate may still be provisioning")
				fmt.Println("• Try again in a few minutes")
			}
		case "HTTPS Connectivity":
			if check.Status != "pass" {
				fmt.Println("• Ensure DNS and SSL are properly configured")
				fmt.Println("• Check that the R2 bucket exists and is accessible")
			}
		}
	}

	if result.OverallStatus == "pass" {
		printSuccess("🎉 Domain is properly configured and ready for use!")
	} else if result.OverallStatus == "warn" {
		printWarning("⏳ Domain configuration is in progress")
	} else {
		printError("❌ Domain configuration has issues that need attention")
	}

	return nil
}

func runDomainPurge(cmd *cobra.Command, args []string) error {
	if len(args) == 0 {
		return fmt.Errorf("domain name is required")
	}
	domainName := args[0]

	path, _ := cmd.Flags().GetString("path")
	everything, _ := cmd.Flags().GetBool("everything")

	// Validate purge options
	if path == "" && !everything {
		return fmt.Errorf("must specify either --path or --everything")
	}
	if path != "" && everything {
		return fmt.Errorf("cannot specify both --path and --everything")
	}

	printInfo("🧹 Purging CDN cache for: %s", domainName)

	if path != "" {
		printInfo("Path: %s", path)
	}
	if everything {
		printInfo("Purging entire cache")
	}

	// Create client
	client, err := getAPIClient()
	if err != nil {
		return fmt.Errorf("failed to create API client: %w", err)
	}

	if DryRun {
		printInfo("DRY RUN: Would purge cache for domain '%s'", domainName)
		if path != "" {
			printInfo("  Path: %s", path)
		}
		if everything {
			printInfo("  Scope: Everything")
		}
		return nil
	}

	// Create domain manager
	domainMgr := domain.NewManager(client.GetCloudflareClient(), client.GetAccountID())

	// Purge cache
	req := &domain.PurgeRequest{
		Domain:     domainName,
		Path:       path,
		Everything: everything,
	}

	err = domainMgr.Purge(req)
	if err != nil {
		return fmt.Errorf("failed to purge cache: %w", err)
	}

	printSuccess("✅ Cache purge initiated successfully!")
	if path != "" {
		printInfo("📄 Path purged: %s", path)
	}
	if everything {
		printInfo("🌐 Entire cache for domain purged")
	}
	printWarning("⏳ Note: Cache invalidation may take a few minutes to complete")
	printInfo("💡 You can verify cache has been cleared by accessing the domain")

	return nil
}

// Helper functions for domain management